# Copie para .env (cp .env.example .env) e ajuste os valores.
# NUNCA versionar o arquivo .env.

# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Necessário ao usar túnel HTTPS (ex.: https://abc123.ngrok-free.app)
CSRF_TRUSTED_ORIGINS=

# Banco PostgreSQL próprio do projeto
POSTGRES_DB=voltasegura
POSTGRES_USER=voltasegura
POSTGRES_PASSWORD=troque-esta-senha
# "localhost" fora do Docker; o docker-compose sobrescreve para "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# E-mail (recuperação de senha). Em desenvolvimento, imprime no terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=VoltaSegura <nao-responda@voltasegura.local>
